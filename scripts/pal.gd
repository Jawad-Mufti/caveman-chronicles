class_name Pal
extends RefCounted
## The whole art direction lives here. Every colour is a weathered earth
## pigment — ochre, umber, charcoal, bone — the same palette the caves were
## painted with. Nothing is saturated: that is what keeps it from reading as a
## cartoon, and it is what makes the game look like its own subject matter.

const OCHRE := Color("b9772f")
const OCHRE_DARK := Color("8a4b2a")
const OCHRE_DEEP := Color("5e3319")
const CHARCOAL := Color("23201c")
const STONE := Color("8d857a")
const STONE_DARK := Color("5f5850")
const BONE := Color("e8e0cd")
const EMBER := Color("c75a33")
const CAVE_TOP := Color("2c1a12")
const CAVE_BOTTOM := Color("6b3f22")

